// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  MANAGER
  TECHNICAL_SUPPORT
  CALL_CENTER
  WORKER
}

enum WorkOrderPriority {
  LOW
MEDIUM
  HIGH
  URGENT
}

enum WorkOrderStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  DECLINED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RecurrenceType {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(WORKER)
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdWorkOrders    WorkOrder[]     @relation("CreatedBy")
  workOrderAssignments WorkOrderAssignment[] @relation("WorkOrderAssignments")
  comments             Comment[]
  notifications        Notification[]
  sentNotifications    Notification[]  @relation("SentBy")
  weeklySchedules      EmployeeSchedule[]  // Weekly template
  scheduleEntries      ScheduleEntry[]     // Actual date-specific entries
  createdStandards     Standard[]      @relation("StandardCreatedBy")
  assignedStandards    Standard[]      @relation("StandardDefaultAssignedTo")
  pushSubscriptions    PushSubscription[]

  @@map("users")
}

model WorkOrder {
  id          String              @id @default(uuid())
  title       String
  description String
  location    String?
  latitude    Float?
  longitude   Float?
  priority    WorkOrderPriority   @default(MEDIUM)
  status      WorkOrderStatus     @default(NEW)
  scheduledDate DateTime?         // When the work is planned to be performed
  deadline    DateTime?           // When the work must be completed by
  resources   String?             // JSON string of required resources

  createdById String
  createdBy   User                @relation("CreatedBy", fields: [createdById], references: [id])

  standardId  String?
  standard    Standard?           @relation(fields: [standardId], references: [id], onDelete: SetNull)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  completedAt DateTime?

  // Relations
  assignments       WorkOrderAssignment[]
  statusHistory     WorkOrderStatusHistory[]
  attachments       Attachment[]
  comments          Comment[]
  notifications     Notification[]
  requiredEquipment WorkOrderEquipment[]

  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([scheduledDate])
  @@index([deadline])
  @@index([standardId])
  @@map("work_orders")
}

model WorkOrderAssignment {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("WorkOrderAssignments", fields: [userId], references: [id])
  assignedAt  DateTime  @default(now())

  @@unique([workOrderId, userId])
  @@index([workOrderId])
  @@index([userId])
  @@map("work_order_assignments")
}

model WorkOrderStatusHistory {
  id           String          @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  oldStatus    WorkOrderStatus?
  newStatus    WorkOrderStatus
  note         String?

  createdAt    DateTime        @default(now())

  @@index([workOrderId])
  @@map("work_order_status_history")
}

model Attachment {
  id           String     @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  fileName     String
  fileUrl      String
  fileType     String     // mime type
  fileSize     Int        // in bytes

  uploadedAt   DateTime   @default(now())

  @@index([workOrderId])
  @@map("attachments")
}

model Comment {
  id           String     @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  userId       String
  user         User       @relation(fields: [userId], references: [id])

  content      String
  isInternal   Boolean    @default(true)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workOrderId])
  @@index([userId])
  @@index([createdAt])  // For sorting comments by date
  @@map("comments")
}

model Notification {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  workOrderId  String?
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  type         String     // NEW_ASSIGNMENT, STATUS_CHANGE, NEW_WORK_ORDER, DEADLINE_WARNING, DEADLINE_EXCEEDED
  title        String
  message      String
  isRead       Boolean    @default(false)

  sentById     String?
  sentBy       User?      @relation("SentBy", fields: [sentById], references: [id])

  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([workOrderId])
  @@index([isRead])
  @@index([userId, isRead]) // Composite index for fetching unread notifications
  @@index([createdAt])      // For sorting by date
  @@map("notifications")
}

model Shift {
  id        String   @id @default(uuid())
  name      String   @unique
  startTime String   // Format: "HH:MM" (24-hour) - primary interval start
  endTime   String   // Format: "HH:MM" (24-hour) - primary interval end
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intervals        ShiftInterval[]     // Additional time intervals
  weeklySchedules  EmployeeSchedule[]  // Weekly template entries
  scheduleEntries  ScheduleEntry[]     // Actual date-specific entries

  @@map("shifts")
}

model ShiftInterval {
  id        String @id @default(uuid())
  shiftId   String
  shift     Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startTime String // Format: "HH:MM" (24-hour)
  endTime   String // Format: "HH:MM" (24-hour)
  sortOrder Int    @default(0)

  @@index([shiftId])
  @@map("shift_intervals")
}

// Weekly schedule template - defines recurring weekly patterns
model EmployeeSchedule {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  shiftId   String
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, dayOfWeek]) // One shift per employee per day
  @@index([userId])
  @@index([shiftId])
  @@index([dayOfWeek])
  @@map("employee_schedules")
}

// Actual schedule entries - date-specific records for historical tracking
model ScheduleEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date  // Specific date (no time component)
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  note      String?  // Optional note (e.g., "Covered for Nikola")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // One shift per employee per date
  @@index([userId])
  @@index([shiftId])
  @@index([date])
  @@map("schedule_entries")
}

// Equipment Management
model EquipmentType {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  equipment   Equipment[]

  @@map("equipment_types")
}

model Equipment {
  id          String        @id @default(uuid())
  name        String
  description String?
  typeId      String
  type        EquipmentType @relation(fields: [typeId], references: [id])
  quantity    Int?          // null = individual item (e.g., vehicle), number = quantity-based (e.g., tools)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workOrders  WorkOrderEquipment[]

  @@index([typeId])
  @@index([isActive])
  @@map("equipment")
}

model WorkOrderEquipment {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  quantity    Int       @default(1) // how many needed for this work order
  createdAt   DateTime  @default(now())

  @@unique([workOrderId, equipmentId])
  @@index([workOrderId])
  @@index([equipmentId])
  @@map("work_order_equipment")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

model StandardGroup {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  standards   Standard[]

  @@index([isActive])
  @@map("standard_groups")
}

model Standard {
  id                  String            @id @default(uuid())
  title               String
  description         String
  location            String?
  latitude            Float?
  longitude           Float?
  priority            WorkOrderPriority @default(MEDIUM)
  recurrenceType      RecurrenceType
  daysOfWeek          DayOfWeek[]       // WEEKLY: specific days; DAILY: empty = all days
  startTime           String            // "HH:MM" format
  endTime             String            // "HH:MM" format
  isActive            Boolean           @default(true)
  createdById         String
  createdBy           User              @relation("StandardCreatedBy", fields: [createdById], references: [id])
  defaultAssignedToId String?
  defaultAssignedTo   User?             @relation("StandardDefaultAssignedTo", fields: [defaultAssignedToId], references: [id])
  groupId             String?
  group               StandardGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  workOrders          WorkOrder[]

  @@index([isActive])
  @@index([groupId])
  @@map("standards")
}
